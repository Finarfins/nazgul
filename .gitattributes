# Windows'ta calisilan bir depo, ama derlemeler macOS (Xcode) ve Linux (CI)
# uzerinde de kosacak. Asagidaki dosyalar satir sonu cevrimine KARSI korunur.

# Gradle sarmalayicisi bir kabuk betigidir. CRLF ile checkout edilirse
# `./gradlew` calismaz — kabuk ilk satirdaki \r'yi yorumlayicinin adinin
# parcasi sayar ve "bad interpreter" verir. Android derlemesi bu betikle
# basladigi icin hatanin bedeli tum mobil derleme zinciridir.
*.sh          text eol=lf
gradlew       text eol=lf

# Windows tarafinin karsiligi; burada CRLF sart.
*.bat         text eol=crlf
gradlew.bat   text eol=crlf

# Surum aktarim isareti. Sunucuya kod `git pull` ile gelmiyor; deploy yontemi
# tarball + dizin takasi (docs/ops/DOMAIN_MIGRATION.md:87-103). `export-subst`
# sayesinde `git archive` bu dosyadaki $Format:%H$ yer tutucusunu paketlenen
# commit'in gercek SHA'siyla degistirir. deploy/sunucu-deploy.sh bu degeri
# imajin OCI `org.opencontainers.image.revision` etiketiyle karsilastirip
# compose/deploy dosyalari ile imajin ayni commit'ten geldigini dogrular.
deploy/RELEASE_SHA export-subst

# Belgeler LF ile saklanir. Depodaki 259 .md dosyasinin TAMAMI bugun zaten
# indekste LF (`git ls-files --eol '*.md'` tek bir `i/lf` kumesi veriyor),
# yani bu satir bir DONUSUM degil bir CIVIDIR: mevcut durumu adlandirir ve
# `core.autocrlf` yanlis kurulmus bir istemcinin CRLF bir blob'u indekse
# sokmasini engeller.
*.md          text eol=lf

# Asagidaki belgeler YALNIZ okunmuyor, FIXTURE olarak AYRISTIRILIYOR:
# `tests/test_wa3_kopru.py` KOPRU_SOZLESMESI.md icindeki ```json blogunu
# bir duzenli ifadeyle (```json\n ... \n```) cikarip UC ALTIN VEKTORU
# oradan okuyor. Bugun bu ayrisma CRLF'e ragmen calisir, ama calismasinin
# NEDENI dosya degil Python'un `read_text` evrensel satir sonu cevrimidir.
# Civi o ortuk katmana olan bagimliligi kaldirir: sozlesme dosyasi diskte
# ne ise ayrisan da odur.
docs/whatsapp/*.md text eol=lf
