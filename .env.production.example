# Production deployment configuration.
#
# Copy this file to .env.production, replace every CHANGE_* placeholder, then
# launch the merged production stack:
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env.production up -d
#
# The production override runs the base compose services too, so this single
# env file must satisfy BOTH docker-compose.yml and docker-compose.prod.yml.
# ENVIRONMENT=production and COOKIE_SECURE=true are hardcoded in
# docker-compose.prod.yml, and CORS_ORIGINS is derived from APP_DOMAIN — do not
# set them here.

# --- Public hostname / TLS (Caddy proxy) ---
# Çalıştırılacak imaj etiketi. deploy/sunucu-deploy.sh bu satırı her deploy'da
# kendisi günceller ve YALNIZ 40 haneli commit SHA'sı kabul eder — 'develop'
# hareketli bir etikettir, bir sonraki merge'de başka bir imajı gösterir ve
# hangi sürümün canlıya çıktığı sonradan kanıtlanamaz. Bkz. docs/ops/DEPLOY.md
#APP_IMAGE_TAG=<40-haneli-commit-sha>

# APP_DOMAIN: TEK alan adı. CORS_ORIGINS ve PUBLIC_APP_URL bundan türetilir;
# oturum çerezi yalnız bu ana kesilir. `www.` alt alan adı Caddy tarafından
# buraya kalıcı yönlendirilir (deploy/Caddyfile), ayrı bir değişken gerekmez.
# A kaydı hem apex hem www için bu sunucuya bakmalı, yoksa Caddy sertifika alamaz.
APP_DOMAIN=harmanzamani.com
ACME_EMAIL=admin@example.com

# --- PostgreSQL ---
# ÜRETİMDE VERİTABANI HARİCİ RDS'TİR. Uygulama ona yalnız DATABASE_URL ile
# bağlanır; compose'un `db` servisi üretimde ÇALIŞMAZ (docker-compose.prod.yml
# içinde `profiles: ["gate"]`). Aşağıdaki POSTGRES_* değerleri yalnız yerel
# `gate` profilinin PostgreSQL testleri içindir. Compose bunları profil
# kapalıyken de yerine koyduğu için TANIMLI KALMALIDIR; silinirse
# `docker compose config` hata verir.
POSTGRES_DB=sungur_erp
POSTGRES_USER=sungur_erp
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD

# --- Application database URL ---
# ÜRETİM: harici RDS endpoint'i. deploy/sunucu-deploy.sh deploy öncesi yedeği
# bu adresten alır (sabit sürümlü geçici postgres konteyneri, salt okuma).
# YEREL `gate` profili: host olarak compose servisi `db` kullanılır.
DATABASE_URL=postgresql+psycopg://sungur_erp:CHANGE_DATABASE_PASSWORD@CHANGE_RDS_ENDPOINT:5432/sungur_erp

# Enable only after the allocation reconciliation/backfill report is approved.
PAYMENT_ALLOCATION_ENGINE_ENABLED=false

# --- Tarla stok outbox tüketicisi ---
# Tarla olaylarını (faaliyet/hasat) stok hareketine çeviren zamanlayıcı.
# Varsayılan KAPALI ve backend/app/FIELD_STOK_OUTBOX_ACILIS_KOSULLARI.md'deki
# dört koşul (hasat→ürün yolu, okuma yüzeyi, yeniden kuyruklama, canlılık
# sinyali) sağlanmadan AÇILMAMALIDIR: bugün her hasat olayı terminal ve
# görünmez bir kovaya düşer ve geri alınamaz. Kapalıyken olaylar PENDING
# birikir; kayıp yoktur, erteleme vardır.
FIELD_STOCK_OUTBOX_ENABLED=false
# Döngüler ARASI bekleme (saniye, 1..3600). Döngünün kendisi ayrıca süre
# bütçesiyle sınırlıdır (bkz. backend/app/field_stok_tuketici.py).
FIELD_STOCK_OUTBOX_INTERVAL_SECONDS=30
# Optional closed-period boundary for reversal/reallocation writes.
# PAYMENT_ALLOCATION_CLOSED_THROUGH=2026-06-30

# --- First-run administrator ---
# 16+ chars, not the default; first login forces a rotation.
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_WITH_A_UNIQUE_16_PLUS_CHARACTER_SECRET

# --- Optional overrides (compose defaults shown) ---
COOKIE_SAMESITE=lax
FORWARDED_ALLOW_IPS=172.16.0.0/12

# --- E-posta teslimi (Amazon SES SMTP) ---
# Bölgeye uygun endpoint kullanın: email-smtp.<bölge>.amazonaws.com
# SMTP kullanıcı adı/parolası SES SMTP credentials değerleridir; AWS access
# key değildir. SMTP_FROM_EMAIL SES'te doğrulanmış bir gönderici olmalıdır.
# SES sandbox hesabı yalnız doğrulanmış alıcılara gönderir; production access
# onaylanmadan gerçek müşteri adreslerine teslim beklemeyin.
NOTIFICATION_PROVIDER=smtp
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_WITH_SES_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_WITH_SES_SMTP_PASSWORD
SMTP_FROM_EMAIL=no-reply@erp.example.com
SMTP_FROM_NAME=Sungur Tarım ERP
SMTP_USE_TLS=true

# --- e-Fatura / e-Arşiv (İzibiz) ---
# SMTP'nin AKSİNE hiçbiri zorunlu değildir: boş bırakılırsa uygulama normal
# açılır ve tüm ERP çalışır; yalnız fatura gönderim ucu
# 503 "E-fatura entegrasyonu yapılandırılmamış" döner (sessiz başarı yok).
# Değerleri İzibiz, entegrasyon hesabını açtığında verir.
# Sağlayıcı: noop (kapalı) | izibiz | nes.
EINVOICE_PROVIDER=noop
# İzibiz servis kökü; AuthenticationWS/EInvoiceWS/EIArchiveWS bu kökten
# türetilir. Test ortamı: https://efaturatest.izibiz.com.tr
EINVOICE_BASE_URL=
# İzibiz entegrasyon hesabının kullanıcı adı ve parolası.
EINVOICE_USERNAME=
EINVOICE_PASSWORD=
# Yalnız Nes sağlayıcısında kullanılır; İzibiz'de boş kalır.
EINVOICE_API_KEY=
# Uç noktaların resmî dokümandan doğrulandığına dair operatör onayı; İzibiz
# için gerekmez (kodda doğrulanmış), Nes açılırken anlamlıdır.
EINVOICE_ENDPOINTS_VERIFIED=false
# Ortam kilidi: test | live. Boş bırakılırsa compose "test"e sabitler.
# DİKKAT: "live" yazmak canlıya çıkmaya YETMEZ — canlı İzibiz adresleri
# app/einvoice/endpoints.py içindeki denylist ile ayrıca kapalıdır; canlı
# faturaya geçiş ayrı ve bilinçli bir karardır.
IZIBIZ_ENV=test

# --- Servis v2: work-order attachment storage ---
# SUNGUR_DATA_DIR BURADAN AYARLANMAZ. docker-compose.prod.yml onu doğrudan app
# servisinin `environment:` bloğunda /opt/sungur-data olarak sabitler ve aynı
# yola sungur_data named volume'unu bağlar. Bu dosyaya yazmak işe YARAMAZ:
# --env-file yalnız compose dosyasındaki ${...} yerine koyma içindir, konteyner
# ortamına değişken taşımaz. Dosyalar $SUNGUR_DATA_DIR/attachments altında,
# platform yedekleri $SUNGUR_DATA_DIR/backups altında tutulur; ikisi de
# volume'da yaşar ve restart/redeploy'u atlatır.
# Comma-separated immutable numeric admin user ids. Empty disables
# the full-database backup UI and API for every tenant administrator.
SUNGUR_PLATFORM_OPERATORS=
BACKUP_RETENTION_COUNT=14
BACKUP_LOCK_TIMEOUT_SECONDS=0
RESTORE_DRAIN_TIMEOUT_SECONDS=60
# Production compose ağı docker-compose.prod.yml içinde 172.28.0.0/16 olarak
# sabitlenmiştir; yalnız bu dosyadaki IPAM değeriyle birlikte değiştirin.
TRUSTED_PROXY_CIDRS=172.28.0.0/16
# Cloudflare Turnstile PUBLIC site anahtarı. TEK kaynak: hem backend
# doğrulaması (app servisi ortam değişkeni) HEM DE frontend build'i için
# kullanılır. Compose bu değeri image build sırasında VITE_TURNSTILE_SITE_KEY
# build arg'ına geçirir; Vite değeri paket içine gömer (public key, güvenli).
# Boş bırakılırsa kayıt formundaki Turnstile widget'ı çizilmez ve TURNSTILE_
# SECRET_KEY dolu olduğunda backend "Bot doğrulaması başarısız" ile reddeder.
# Değeri değiştirdikten sonra image'i YENİDEN build edin (build-time inlining).
TURNSTILE_SITE_KEY=
# Turnstile GİZLİ anahtarı (yalnız backend doğrulaması).
TURNSTILE_SECRET_KEY=
