# Sungur Tarım ERP production configuration
ENVIRONMENT=production
APP_NAME=Sungur Tarım ERP

# PostgreSQL 16
DATABASE_URL=postgresql+psycopg://sungur_erp:CHANGE_DATABASE_PASSWORD@postgres:5432/sungur_erp
AUTO_MIGRATE=true
MIGRATION_LOCK_TIMEOUT_SECONDS=120

# First-run administrator. Replace every value before deployment.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Sistem Yöneticisi
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_WITH_A_UNIQUE_16_PLUS_CHARACTER_SECRET
# Doğrulama bağlantısı bu adresten kurulur. Production'da https zorunludur ve
# localhost kabul edilmez.
PUBLIC_APP_URL=https://erp.example.com
# E-posta teslimi. Production'da NOTIFICATION_PROVIDER=smtp ile SMTP_HOST ve
# SMTP_FROM_EMAIL zorunludur; eksikse uygulama açılmaz (sessizce mailsiz
# çalışmaz). Kuyruk drenajı: backend/scripts/dispatch_notifications.py (cron).
NOTIFICATION_PROVIDER=smtp
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Sungur Tarım ERP
# SMTP_USERNAME tanımlıyken false olamaz (kimlik bilgisi düz metin gitmesin).
SMTP_USE_TLS=true

# Browser security. Production must be served through HTTPS.
COOKIE_SECURE=true
SUNGUR_PLATFORM_OPERATORS=
BACKUP_RETENTION_COUNT=14
BACKUP_LOCK_TIMEOUT_SECONDS=0
RESTORE_DRAIN_TIMEOUT_SECONDS=60
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Explicit origins only; wildcard (*) is rejected.
CORS_ORIGINS=https://erp.example.com

# Request boundary limits (bytes, 1024..104857600). The import override must
# stay above the 10 MiB Excel upload limit enforced inside /api/imports/*.
MAX_REQUEST_BODY_BYTES=2097152
MAX_IMPORT_REQUEST_BODY_BYTES=11534336

# --- e-Fatura / e-Arşiv (İzibiz) ---
# Tamamı opsiyoneldir. Boş bırakılırsa uygulama normal açılır ve çalışır;
# yalnız fatura gönderim ucu 503 "E-fatura entegrasyonu yapılandırılmamış"
# döner. Hiçbiri uygulamayı açılışta öldürmez (SMTP'den farkı budur).
# Sağlayıcı adı: noop (kapalı) | izibiz | nes.
EINVOICE_PROVIDER=noop
# İzibiz servis kökü. Test ortamı: https://efaturatest.izibiz.com.tr
# (üç servis — AuthenticationWS/EInvoiceWS/EIArchiveWS — bu kökten türetilir).
EINVOICE_BASE_URL=
# İzibiz portal kullanıcı adı — İzibiz'in verdiği entegrasyon hesabı.
EINVOICE_USERNAME=
# Aynı hesabın parolası. Bu dosyaya GERÇEK DEĞER YAZMAYIN.
EINVOICE_PASSWORD=
# Yalnız Nes sağlayıcısı için ek API anahtarı; İzibiz kullanmaz.
EINVOICE_API_KEY=
# Uç noktaların resmî dokümandan doğrulandığına dair operatör onayı. İzibiz
# için gerekmez (kodda zaten doğrulanmış); yalnız Nes'i açarken anlamlı.
EINVOICE_ENDPOINTS_VERIFIED=false
# Ortam kilidi: test | live. BOŞ BIRAKMAYIN — boş dize hata verir, "test"e
# düşmez. "live" değeri tek başına canlıya çıkarmaz; canlı uçlar kod içindeki
# denylist ile ayrıca kapalıdır (app/einvoice/endpoints.py).
IZIBIZ_ENV=test

# --- Tarla stok outbox tüketicisi ---
# Tarla olaylarını (faaliyet/hasat) stok hareketine çeviren zamanlayıcı.
# Varsayılan KAPALI ve app/FIELD_STOK_OUTBOX_ACILIS_KOSULLARI.md'deki dört
# koşul (hasat→ürün yolu, okuma yüzeyi, yeniden kuyruklama, canlılık sinyali)
# sağlanmadan AÇILMAMALIDIR: bugün her hasat olayı terminal ve görünmez bir
# kovaya düşer ve geri alınamaz. Kapalıyken olaylar PENDING birikir; kayıp
# yoktur, erteleme vardır.
FIELD_STOCK_OUTBOX_ENABLED=false
# Döngüler ARASI bekleme (saniye, 1..3600). Döngünün kendisi ayrıca süre
# bütçesiyle sınırlıdır (bkz. app/field_stok_tuketici.py).
FIELD_STOCK_OUTBOX_INTERVAL_SECONDS=30

# Runtime
DEMO_MODE=false
# Cloudflare Turnstile PUBLIC site anahtarı. Tek kaynak: HEM backend
# doğrulaması HEM DE frontend build'i için kullanılır. Compose bu değeri image
# build sırasında VITE_TURNSTILE_SITE_KEY build arg'ına geçirir; Vite değeri
# paket içine gömer. Değeri değiştirince image'i yeniden build edin.
TURNSTILE_SITE_KEY=
# Turnstile GİZLİ anahtarı (yalnız backend doğrulaması).
TURNSTILE_SECRET_KEY=

# WA3-core: Harman AI köprüsü. Üçü de boşken köprü KAPALIDIR (ağa çıkılmaz).
# HARMAN_KOPRU_URL=
# HARMAN_KOPRU_SIRRI=
# HARMAN_KOPRU_SIRRI_IKINCIL=

# WA1: Meta WhatsApp webhook girişi. ÜÇÜ DE boşken kanal KAPALIDIR ve
# /api/whatsapp/webhook 404 döner — yani hiçbir gövde ayrıştırılmaz, hiçbir
# satır yazılmaz. Üçü de ZORUNLU: imza sırrı olmadan gövdenin kaynağı
# bilinemez, doğrulama jetonu olmadan Meta kurulumu tamamlanamaz ve
# phone_number_id olmadan aynı Meta uygulamasındaki BAŞKA bir işletme
# numarasının mesajı da kabul edilirdi (HMAC hepsinde AYNI sırla atılır).
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Oturum ve çerez adları ---
# Erişim belirteci çerezinin adı.
ACCESS_COOKIE_NAME=yhp_access_token
# Yenileme belirteci çerezinin adı.
REFRESH_COOKIE_NAME=yhp_refresh_token
# CSRF koruma belirteci çerezinin adı.
CSRF_COOKIE_NAME=yhp_csrf_token

# --- Veritabanı ve hazırlık probu zaman aşımı bütçeleri ---
# Veritabanına bağlanma denemesinin üst sınır süresi (saniye).
DB_CONNECT_TIMEOUT_SECONDS=5
# Yerel SQLite kilit bekleme süresi (milisaniye).
SQLITE_BUSY_TIMEOUT_MS=5000
# Hazırlık probunun toplam süre bütçesi (saniye).
READINESS_TIMEOUT_SECONDS=8
# Aynı anda eşzamanlı çalışabilecek hazırlık probu sayısı.
READINESS_MAX_INFLIGHT=4

# --- İstek gövdesi ve dosya yükleme sınırları ---
# İş emri ekleri ve görsel yüklemeleri için azami dosya boyutu (bayt).
MAX_ATTACHMENT_UPLOAD_BYTES=10485760
# Tedarikçi fiyat listesi içe aktarma istekleri için azami gövde boyutu (bayt).
MAX_SUPPLIER_PRICE_IMPORT_REQUEST_BODY_BYTES=27262976

# --- Kalıcı veri dizini ve vekil ağları ---
# Kalıcı veri ve ek dosyaların saklanacağı dizin yolu.
SUNGUR_DATA_DIR=data
# Güvenilir ters vekil CIDR blokları (virgülle ayrılmış).
# TRUSTED_PROXY_CIDRS=
# SEC-6: IP basina saatlik giris tavani (yalniz BASARISIZ girisler sayilir)
# LOGIN_IP_LIMIT_PER_HOUR=200
# SEC-6: WhatsApp webhook'unda IP basina saatlik IMZASI DUSEN istek tavani
# WHATSAPP_WEBHOOK_BAD_SIGNATURE_LIMIT_PER_HOUR=60

# --- Bildirim saklama süresi ---
# İptal edilmiş/silahsızlandırılmış bildirimlerin saklanma süresi (gün).
NOTIFICATION_DISARMED_RETENTION_DAYS=90

# --- Tahsilat ve kapalı dönem ayarları ---
# Tahsilat tahsis motoru etkinleştirme bayrağı.
PAYMENT_ALLOCATION_ENGINE_ENABLED=false
# Kapalı dönem sınırı (bu tarihe kadar olan dönem kilitlidir).
# PAYMENT_ALLOCATION_CLOSED_THROUGH=
# Alacak dekontu tahsis motoru etkinleştirme bayrağı.
RECEIVABLE_CHARGE_ALLOCATION_ENABLED=false

# --- e-Fatura ek ayarları ---
# Gönderici VKN (boş bırakılırsa firma profilindeki vergi numarası kullanılır).
# EINVOICE_SENDER_VKN=

# --- WhatsApp Entegrasyonu ek ayarları (WA1-WA5) ---
# Meta WhatsApp Graph API mesaj gönderim erişim jetonu.
# WHATSAPP_ACCESS_TOKEN=
# Meta Graph API servis taban adresi.
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# Meta Graph API sürüm etiketi.
WHATSAPP_GRAPH_VERSION=v21.0
# Arka plan WhatsApp gelen mesaj işçi zamanlayıcısını çalıştırma bayrağı.
WHATSAPP_WORKER_ENABLED=false
# WhatsApp işçisinin kuyruk yoklama aralığı (saniye).
WHATSAPP_WORKER_INTERVAL_SECONDS=5
# WhatsApp işçisinin her döngüde işleyeceği azami mesaj sayısı.
WHATSAPP_WORKER_BATCH=10
