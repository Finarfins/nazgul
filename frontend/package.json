{
  "name": "yerel-hesap-pro-next",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:bridge": "tsc -b && vite build --mode bridge",
    "build:field-pwa": "tsc -b && vite build --mode field-pwa",
    "build:mobil": "tsc -b && vite build --mode mobil",
    "mobil:sync": "npm run build:mobil && cap sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:audit-policy": "node --test scripts/check-audit-policy.test.mjs",
    "audit:policy": "node scripts/check-audit-policy.mjs",
    "lint": "eslint src e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "types:gen": "openapi-typescript ../backend/openapi.json -o src/api/types.gen.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/x-data-grid": "^8.16.0",
    "axios": "^1.12.2",
    "decimal.js": "^10.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  }
}
