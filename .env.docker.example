# Local / single-host Docker configuration for the base compose stack.
#
# Copy this file to .env.docker, replace the placeholders, then launch:
#
#   docker compose --env-file .env.docker up -d
#
# For production use .env.production with docker-compose.prod.yml instead
# (see .env.production.example).

# --- PostgreSQL (db service) ---
POSTGRES_DB=yerelhesap
POSTGRES_USER=yerelhesap
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD

# --- Application database URL ---
# Must match the POSTGRES_* values above; the host is the compose service `db`.
DATABASE_URL=postgresql+psycopg://yerelhesap:CHANGE_DATABASE_PASSWORD@db:5432/yerelhesap

# --- Optional overrides (compose defaults shown) ---
CORS_ORIGINS=http://localhost:5050,http://127.0.0.1:5050
AUTO_MIGRATE=true
PAYMENT_ALLOCATION_ENGINE_ENABLED=false
# PAYMENT_ALLOCATION_CLOSED_THROUGH=2026-06-30
COOKIE_SECURE=false
SUNGUR_PLATFORM_OPERATORS=
BACKUP_RETENTION_COUNT=14
BACKUP_LOCK_TIMEOUT_SECONDS=0
RESTORE_DRAIN_TIMEOUT_SECONDS=60
COOKIE_SAMESITE=lax
# Production override ile kullanıldığında sabit proxy ağı:
TRUSTED_PROXY_CIDRS=172.28.0.0/16
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Frontend build'ine TURNSTILE_SITE_KEY ile aynı public site anahtarını iletir.
VITE_TURNSTILE_SITE_KEY=
